{
  "name": "facets-stress-test",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": false,
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [
      { "name": "LAB", "class_name": "Lab" },
      { "name": "LEDGER", "class_name": "Ledger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lab", "Ledger"] }],
  // Optional dead-man switch: after this ISO time every request gets 410.
  // Set it when you deploy, e.g. --var EXPIRES:2026-12-01T00:00:00Z. Empty = no expiry.
  "vars": { "EXPIRES": "" },
  "observability": { "enabled": true }
}
